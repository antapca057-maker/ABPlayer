<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/apk/res/android">

    <!-- Разрешение для Android 12 и старше (автоматически игнорируется на Android 13+) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    
    <!-- Разрешение для Android 13 и 14+ (доступ конкретно к аудиофайлам) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- Разрешение на показ уведомлений в шторке (обязательно для Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Разрешение, чтобы система не усыпляла процессор при выключении экрана -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Разрешение для запуска фоновой службы (обязательно начиная с Android 9) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:label="ABPlayer"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
        tools:targetApi="34">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Фоновая служба с явным указанием типа медиа-плеера для Android 14 -->
        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            tools:targetApi="34" />
            
    </application>

</manifest>